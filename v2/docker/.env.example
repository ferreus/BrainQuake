# Copy to .env (same directory) and point this at your real FreeSurfer license.txt
# (free registration: https://surfer.nmr.mgh.harvard.edu/registration.html).
# Never commit an actual license.txt or a filled-in .env.
FS_LICENSE_HOST=/absolute/path/to/your/license.txt

WEB_PORT=80

# --- Non-root runtime user (api/worker, and fastsurfer-worker via its own
# `user:` override in docker-compose.yml) -----------------------------
# These are build args, not env vars read at container start -- changing
# either requires rebuilding api/worker (`docker compose build api`).
# Default 1000:1000 (the conventional first regular Linux user) is fine
# unless you specifically need to match a host UID for bind-mount reasons.
APP_UID=1000
APP_GID=1000

# --- General job concurrency ------------------------------------------
# How many jobs (across all subjects/types, except fast-surfer recon -- see
# below) the worker executes at once. Jobs for the same patient never run
# concurrently regardless of this value (enforced in
# app/workers/jobs_worker.py's atomic claim) -- this only bounds
# different-patient parallelism.
MAX_CONCURRENT_JOBS=2

# --- FastSurfer sidecar (optional) --------------------------------------
# FastSurfer runs via its own small HTTP-wrapped service (see
# fastsurfer-worker.Dockerfile / v2/fastsurfer-worker), never inside
# api/worker's own container. Disabled by default -- a recon request with
# recon_type=fast-surfer fails with a clear error until this is turned on
# AND the fastsurfer-worker service is actually running. Bring it up with:
#   docker compose -f docker-compose.yml --profile fastsurfer up --build          (CPU)
#   docker compose -f docker-compose.yml -f docker-compose.fastsurfer-gpu.yml \
#     --profile fastsurfer up --build                                            (GPU)
FASTSURFER_ENABLED=false
FASTSURFER_WORKER_URL=http://fastsurfer-worker:8000
# Single-GPU deployments: keep this at 1 to avoid GPU memory contention from
# concurrent FastSurfer runs. Independent of MAX_CONCURRENT_JOBS above --
# FastSurfer jobs are dispatched by their own separate pool and never
# consume/block the general one.
FASTSURFER_MAX_CONCURRENT=1
FASTSURFER_POLL_INTERVAL_SECONDS=10
FASTSURFER_THREADS=8
# "cpu" is the safe default. On GPU hosts set BOTH this AND
# FASTSURFER_VARIANT below to "cuda" (FASTSURFER_VARIANT picks which image
# gets built, this picks the --device flag passed to run_fastsurfer.sh at
# runtime), AND launch with the docker-compose.fastsurfer-gpu.yml override
# (see above) -- that's what actually grants the container GPU access; this
# variable alone does not. Requires the NVIDIA Container Toolkit on the host
# (`nvidia-smi` working on the host is not enough by itself -- check
# `docker info` lists an `nvidia` runtime).
FASTSURFER_DEVICE=cpu
# deepmi/fastsurfer tags are named <variant>-v<version>, e.g. cpu-v2.5.4,
# cuda-v2.5.4 -- there is no bare "v2.5.4" tag. Full list of variants (also
# includes rocm/rocm6.3 for AMD GPUs, and cu118/cu126/cu128 to pin a specific
# CUDA toolkit instead of the generic "cuda" alias):
# https://hub.docker.com/r/deepmi/fastsurfer/tags
FASTSURFER_VARIANT=cpu
FASTSURFER_VERSION=v2.5.4
